data/raw/**/*.png
data/raw/**/*.jpg
data/raw/**/*.jpeg
data/processed/**/*.png
data/processed/**/*.jpg
!data/raw/**/.gitkeep
!data/processed/**/.gitkeep
data/labels.csv
data/labels_synthetic.csv
data/train.csv
data/test.csv

# Reports (regeneratable via evaluate.py / tesseract_baseline.py)
reports/
